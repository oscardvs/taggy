<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ============================================================ -->
  <!-- SIMULATED REALSENSE D435i CAMERA                             -->
  <!-- Provides RGB, Depth, Infrared, and IMU streams               -->
  <!-- ============================================================ -->
  <xacro:macro name="realsense_d435_sim" params="robot_name:=go2 parent_link:=base_link camera_name:=camera">

    <!-- Camera housing link -->
    <link name="${camera_name}_link">
      <inertial>
        <mass value="0.072"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.025 0.090 0.025"/>
        </geometry>
        <material name="aluminum">
          <color rgba="0.5 0.5 0.5 1"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.025 0.090 0.025"/>
        </geometry>
      </collision>
    </link>

    <!-- Camera mount joint -->
    <joint name="${camera_name}_joint" type="fixed">
      <parent link="${parent_link}"/>
      <child link="${camera_name}_link"/>
      <!-- Mounted on front of robot, looking forward -->
      <origin xyz="0.30 0.0 0.05" rpy="0 0 0"/>
    </joint>

    <!-- Depth optical frame -->
    <link name="${camera_name}_depth_optical_frame"/>
    <joint name="${camera_name}_depth_optical_joint" type="fixed">
      <parent link="${camera_name}_link"/>
      <child link="${camera_name}_depth_optical_frame"/>
      <!-- ROS optical frame convention: Z forward, X right, Y down -->
      <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
    </joint>

    <!-- Color optical frame -->
    <link name="${camera_name}_color_optical_frame"/>
    <joint name="${camera_name}_color_optical_joint" type="fixed">
      <parent link="${camera_name}_link"/>
      <child link="${camera_name}_color_optical_frame"/>
      <origin xyz="0 0.015 0" rpy="${-pi/2} 0 ${-pi/2}"/>
    </joint>

    <!-- Infrared 1 optical frame -->
    <link name="${camera_name}_infra1_optical_frame"/>
    <joint name="${camera_name}_infra1_optical_joint" type="fixed">
      <parent link="${camera_name}_link"/>
      <child link="${camera_name}_infra1_optical_frame"/>
      <origin xyz="0 -0.025 0" rpy="${-pi/2} 0 ${-pi/2}"/>
    </joint>

    <!-- Infrared 2 optical frame -->
    <link name="${camera_name}_infra2_optical_frame"/>
    <joint name="${camera_name}_infra2_optical_joint" type="fixed">
      <parent link="${camera_name}_link"/>
      <child link="${camera_name}_infra2_optical_frame"/>
      <origin xyz="0 0.025 0" rpy="${-pi/2} 0 ${-pi/2}"/>
    </joint>

    <!-- ============================================================ -->
    <!-- RGB CAMERA SENSOR                                            -->
    <!-- ============================================================ -->
    <gazebo reference="${camera_name}_link">
      <sensor type="camera" name="${camera_name}_color">
        <update_rate>30.0</update_rate>
        <visualize>false</visualize>
        <camera name="${camera_name}_color">
          <horizontal_fov>1.211</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>
        </camera>
        <plugin name="${camera_name}_color_controller" filename="libgazebo_ros_camera.so">
          <ros>
            <namespace>${robot_name}</namespace>
            <remapping>image_raw:=${camera_name}/color/image_raw</remapping>
            <remapping>camera_info:=${camera_name}/color/camera_info</remapping>
          </ros>
          <frame_name>${camera_name}_color_optical_frame</frame_name>
          <camera_name>${camera_name}/color</camera_name>
          <hack_baseline>0.07</hack_baseline>
        </plugin>
      </sensor>
    </gazebo>

    <!-- ============================================================ -->
    <!-- DEPTH CAMERA SENSOR (RGBD)                                   -->
    <!-- ============================================================ -->
    <gazebo reference="${camera_name}_link">
      <sensor type="depth" name="${camera_name}_depth">
        <update_rate>30.0</update_rate>
        <visualize>false</visualize>
        <camera name="${camera_name}_depth">
          <horizontal_fov>1.489</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>10</far>
          </clip>
        </camera>
        <plugin name="${camera_name}_depth_controller" filename="libgazebo_ros_camera.so">
          <ros>
            <namespace>${robot_name}</namespace>
            <remapping>image_raw:=${camera_name}/depth/image_rect_raw</remapping>
            <remapping>camera_info:=${camera_name}/depth/camera_info</remapping>
            <remapping>points:=${camera_name}/depth/color/points</remapping>
          </ros>
          <frame_name>${camera_name}_depth_optical_frame</frame_name>
          <camera_name>${camera_name}/depth</camera_name>
          <hack_baseline>0.07</hack_baseline>
          <min_depth>0.1</min_depth>
          <max_depth>10.0</max_depth>
        </plugin>
      </sensor>
    </gazebo>

    <!-- ============================================================ -->
    <!-- INFRARED CAMERA SENSOR (Left IR)                             -->
    <!-- ============================================================ -->
    <gazebo reference="${camera_name}_link">
      <sensor type="camera" name="${camera_name}_infra1">
        <update_rate>30.0</update_rate>
        <visualize>false</visualize>
        <camera name="${camera_name}_infra1">
          <horizontal_fov>1.489</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>L8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>
        </camera>
        <plugin name="${camera_name}_infra1_controller" filename="libgazebo_ros_camera.so">
          <ros>
            <namespace>${robot_name}</namespace>
            <remapping>image_raw:=${camera_name}/infra1/image_rect_raw</remapping>
            <remapping>camera_info:=${camera_name}/infra1/camera_info</remapping>
          </ros>
          <frame_name>${camera_name}_infra1_optical_frame</frame_name>
          <camera_name>${camera_name}/infra1</camera_name>
        </plugin>
      </sensor>
    </gazebo>

    <!-- ============================================================ -->
    <!-- CAMERA IMU SENSOR                                            -->
    <!-- ============================================================ -->
    <link name="${camera_name}_imu_frame"/>
    <joint name="${camera_name}_imu_joint" type="fixed">
      <parent link="${camera_name}_link"/>
      <child link="${camera_name}_imu_frame"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <gazebo reference="${camera_name}_imu_frame">
      <gravity>true</gravity>
      <sensor name="${camera_name}_imu" type="imu">
        <always_on>true</always_on>
        <update_rate>200</update_rate>
        <visualize>false</visualize>
        <plugin filename="libgazebo_ros_imu_sensor.so" name="${camera_name}_imu_plugin">
          <ros>
            <namespace>${robot_name}</namespace>
            <remapping>~/out:=${camera_name}/imu</remapping>
          </ros>
          <initial_orientation_as_reference>false</initial_orientation_as_reference>
          <frame_name>${camera_name}_imu_frame</frame_name>
        </plugin>
      </sensor>
    </gazebo>

  </xacro:macro>

</robot>

