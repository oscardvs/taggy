<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="go2_gazebo_classic" params="robot_name:=go2">

    <!-- ============================================================ -->
    <!-- GAZEBO ROS2 CONTROL PLUGIN (Gazebo Classic)                  -->
    <!-- ============================================================ -->
    <gazebo>
      <plugin filename="libgazebo_ros2_control.so" name="gazebo_ros2_control">
        <robot_param>robot_description</robot_param>
        <robot_param_node>robot_state_publisher</robot_param_node>
        <parameters>$(find go2_gazebo)/config/ros2_controllers.yaml</parameters>
      </plugin>
    </gazebo>

    <!-- ============================================================ -->
    <!-- ROS2 CONTROL HARDWARE INTERFACE                              -->
    <!-- ============================================================ -->
    <ros2_control name="GazeboSystem" type="system">
      <hardware>
        <plugin>gazebo_ros2_control/GazeboSystem</plugin>
      </hardware>
      
      <!-- Front Left Leg - Initial standing pose -->
      <joint name="lf_hip_joint">
        <param name="initial_position">0.0</param>
        <command_interface name="position">
          <param name="min">-1.047</param>
          <param name="max">1.047</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="lf_upper_leg_joint">
        <param name="initial_position">0.8</param>
        <command_interface name="position">
          <param name="min">-1.5</param>
          <param name="max">3.4</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="lf_lower_leg_joint">
        <param name="initial_position">-1.5</param>
        <command_interface name="position">
          <param name="min">-2.7</param>
          <param name="max">-0.9</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      
      <!-- Front Right Leg - Initial standing pose -->
      <joint name="rf_hip_joint">
        <param name="initial_position">0.0</param>
        <command_interface name="position">
          <param name="min">-1.047</param>
          <param name="max">1.047</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="rf_upper_leg_joint">
        <param name="initial_position">0.8</param>
        <command_interface name="position">
          <param name="min">-1.5</param>
          <param name="max">3.4</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="rf_lower_leg_joint">
        <param name="initial_position">-1.5</param>
        <command_interface name="position">
          <param name="min">-2.7</param>
          <param name="max">-0.9</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>

      <!-- Rear Left Leg - Initial standing pose -->
      <joint name="lh_hip_joint">
        <param name="initial_position">0.0</param>
        <command_interface name="position">
          <param name="min">-1.047</param>
          <param name="max">1.047</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="lh_upper_leg_joint">
        <param name="initial_position">0.8</param>
        <command_interface name="position">
          <param name="min">-1.5</param>
          <param name="max">4.5</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="lh_lower_leg_joint">
        <param name="initial_position">-1.5</param>
        <command_interface name="position">
          <param name="min">-2.7</param>
          <param name="max">-0.9</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>

      <!-- Rear Right Leg - Initial standing pose -->
      <joint name="rh_hip_joint">
        <param name="initial_position">0.0</param>
        <command_interface name="position">
          <param name="min">-1.047</param>
          <param name="max">1.047</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="rh_upper_leg_joint">
        <param name="initial_position">0.8</param>
        <command_interface name="position">
          <param name="min">-1.5</param>
          <param name="max">4.5</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="rh_lower_leg_joint">
        <param name="initial_position">-1.5</param>
        <command_interface name="position">
          <param name="min">-2.7</param>
          <param name="max">-0.9</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
    </ros2_control>

    <!-- ============================================================ -->
    <!-- IMU SENSOR                                                   -->
    <!-- ============================================================ -->
    <gazebo reference="imu_link">
      <gravity>true</gravity>
      <sensor name="imu_sensor" type="imu">
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <visualize>false</visualize>
        <plugin filename="libgazebo_ros_imu_sensor.so" name="imu_plugin">
          <ros>
            <namespace>${robot_name}</namespace>
            <remapping>~/out:=imu/data</remapping>
          </ros>
          <initial_orientation_as_reference>false</initial_orientation_as_reference>
          <frame_name>imu_link</frame_name>
        </plugin>
      </sensor>
    </gazebo>

    <!-- ============================================================ -->
    <!-- 2D LIDAR (Simulated Hesai XT16 style)                        -->
    <!-- ============================================================ -->
    <gazebo reference="laser_frame">
      <sensor type="ray" name="lidar_sensor">
        <pose>0 0 0 0 0 0</pose>
        <visualize>false</visualize>
        <update_rate>10</update_rate>
        <ray>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.10</min>
            <max>30.0</max>
            <resolution>0.01</resolution>
          </range>
        </ray>
        <plugin name="laser_scan_plugin" filename="libgazebo_ros_ray_sensor.so">
          <ros>
            <namespace>${robot_name}</namespace>
            <remapping>~/out:=scan</remapping>
          </ros>
          <output_type>sensor_msgs/LaserScan</output_type>
          <frame_name>laser_frame</frame_name>
        </plugin>
      </sensor>
    </gazebo>

    <!-- ============================================================ -->
    <!-- 3D LIDAR (PointCloud - Simulated Hesai XT16)                 -->
    <!-- ============================================================ -->
    <gazebo reference="laser_frame">
      <sensor type="ray" name="lidar_3d_sensor">
        <pose>0 0 0 0 0 0</pose>
        <visualize>false</visualize>
        <update_rate>10</update_rate>
        <ray>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
            <vertical>
              <samples>16</samples>
              <resolution>1</resolution>
              <min_angle>-0.261799</min_angle>
              <max_angle>0.261799</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.10</min>
            <max>100.0</max>
            <resolution>0.01</resolution>
          </range>
        </ray>
        <plugin name="pointcloud_plugin" filename="libgazebo_ros_ray_sensor.so">
          <ros>
            <namespace>${robot_name}</namespace>
            <remapping>~/out:=lidar_points</remapping>
          </ros>
          <output_type>sensor_msgs/PointCloud2</output_type>
          <frame_name>laser_frame</frame_name>
        </plugin>
      </sensor>
    </gazebo>

    <!-- ============================================================ -->
    <!-- GROUND TRUTH ODOMETRY (for testing/debugging)               -->
    <!-- ============================================================ -->
    <gazebo>
      <plugin name="ground_truth_odom" filename="libgazebo_ros_p3d.so">
        <ros>
          <namespace>${robot_name}</namespace>
          <remapping>odom:=ground_truth/odom</remapping>
        </ros>
        <body_name>base_link</body_name>
        <frame_name>world</frame_name>
        <update_rate>50.0</update_rate>
        <gaussian_noise>0.0</gaussian_noise>
      </plugin>
    </gazebo>

    <!-- ============================================================ -->
    <!-- FRICTION PROPERTIES                                          -->
    <!-- ============================================================ -->
    <gazebo reference="trunk">
      <mu1>0.2</mu1>
      <mu2>0.2</mu2>
      <kp>1000000.0</kp>
      <kd>100.0</kd>
    </gazebo>

    <!-- Foot friction for all legs -->
    <xacro:macro name="foot_friction" params="leg_prefix">
      <gazebo reference="${leg_prefix}_foot_link">
        <mu1>0.8</mu1>
        <mu2>0.8</mu2>
        <kp>1000000.0</kp>
        <kd>100.0</kd>
        <minDepth>0.001</minDepth>
        <maxContacts>1</maxContacts>
      </gazebo>
    </xacro:macro>

    <xacro:foot_friction leg_prefix="lf"/>
    <xacro:foot_friction leg_prefix="rf"/>
    <xacro:foot_friction leg_prefix="lh"/>
    <xacro:foot_friction leg_prefix="rh"/>

    <!-- Leg link properties -->
    <xacro:macro name="leg_properties" params="leg_prefix">
      <gazebo reference="${leg_prefix}_hip_link">
        <mu1>0.2</mu1>
        <mu2>0.2</mu2>
        <self_collide>false</self_collide>
      </gazebo>
      <gazebo reference="${leg_prefix}_upper_leg_link">
        <mu1>0.2</mu1>
        <mu2>0.2</mu2>
        <self_collide>true</self_collide>
      </gazebo>
      <gazebo reference="${leg_prefix}_lower_leg_link">
        <mu1>0.2</mu1>
        <mu2>0.2</mu2>
        <self_collide>true</self_collide>
      </gazebo>
    </xacro:macro>

    <xacro:leg_properties leg_prefix="lf"/>
    <xacro:leg_properties leg_prefix="rf"/>
    <xacro:leg_properties leg_prefix="lh"/>
    <xacro:leg_properties leg_prefix="rh"/>

  </xacro:macro>

</robot>

